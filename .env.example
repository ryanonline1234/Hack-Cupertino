# ── Server-only secrets ──────────────────────────────────────────────────────
# These are read by the serverless functions in api/ and are never sent to the
# browser. Do NOT rename them with a VITE_ prefix: Vite inlines every VITE_*
# variable into the production bundle, which is exactly the leak we just fixed.

# Anthropic API key for the community narrative (api/llmapi.js).
ANTHROPIC_API_KEY=your_key_here

# US Census API key for ACS demographics (api/census.js).
# Request one at https://api.census.gov/data/key_signup.html
CENSUS_KEY=your_key_here

# ── Optional configuration ───────────────────────────────────────────────────
# Claude model used for the narrative. Defaults to claude-opus-5.
# Cheaper alternative: claude-haiku-4-5
# LLM_MODEL=claude-opus-5

# Extra origins allowed to call the api/ endpoints, comma-separated. Vercel's
# own deployment URLs and localhost are allowed automatically; add a custom
# domain here.
# ALLOWED_ORIGINS=https://food-desert-ai.vercel.app
