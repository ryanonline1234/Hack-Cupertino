# Copy to .env for local development (this file is a template — .env is gitignored).
#
# AI narrative (optional but recommended for the full experience):
#   Local dev (vite proxy -> OpenRouter):  VITE_OPEN_ROUTER_API_KEY
#   Production (Vercel serverless api/llmapi.js): OPEN_ROUTER_API_KEY
# Get a key at https://openrouter.ai/keys
# Without a key the app still runs — the Community Narrative panel shows an
# on-demand prompt instead of generated text. All maps, designation,
# evidence-trace, and impact-projection features work keyless.
VITE_OPEN_ROUTER_API_KEY=your_key_here
OPEN_ROUTER_API_KEY=your_key_here

# Census ACS demographics (optional — app falls back to built-in defaults):
VITE_CENSUS_KEY=your_key_here

# Legacy aliases (still honored, prefer the names above):
# VITE_ANTHROPIC_KEY=your_key_here
# LLMAPI_KEY=your_key_here
