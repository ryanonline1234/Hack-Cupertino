# ── Server-only secrets ──────────────────────────────────────────────────────
# These are read by the serverless functions in api/ and are never sent to the
# browser. Do NOT rename them with a VITE_ prefix: Vite inlines every VITE_*
# variable into the production bundle, which would publish the key.

# Narrative provider key. Which one you need depends on LLM_PROVIDER below.
# Default provider is OpenRouter.
OPENROUTER_API_KEY=your_key_here

# Only needed if you set LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=your_key_here

# US Census API key, used for ACS demographics and block-group population
# weighting. Free: https://api.census.gov/data/key_signup.html
CENSUS_KEY=your_key_here

# ── Optional configuration ───────────────────────────────────────────────────
# Narrative provider: openrouter (default) or anthropic.
# LLM_PROVIDER=openrouter

# Model id. Defaults per provider:
#   openrouter -> openrouter/free  (auto-selects among available free models,
#                 filtering for the capabilities the request needs; survives
#                 free-model deprecation, but tone varies between requests)
#   anthropic  -> claude-opus-5
# Pin a specific free model here if you want consistent tone, accepting that
# free model ids are retired without notice.
# LLM_MODEL=openrouter/free

# Sent to OpenRouter as the HTTP-Referer attribution header. Falls back to the
# Vercel production URL when unset.
# OPENROUTER_SITE_URL=https://food-desert-ai.vercel.app

# Extra origins allowed to call the api/ endpoints, comma-separated. Vercel's
# own deployment URLs and localhost are allowed automatically.
# ALLOWED_ORIGINS=https://food-desert-ai.vercel.app
