# Copy to .env for local development (this file is a template — .env is gitignored).
#
# Census ACS demographics. Server-only: read by api/acs.js on Vercel and by the
# local dev middleware (vite-plugin-api-dev.js). Never prefix it with VITE_ —
# Vite inlines VITE_* values into the client bundle, and the build fails if a
# private key value shows up there (scripts/check-bundle-for-keys.mjs).
# Without it the app still runs; tract demographics fall back to defaults.
CENSUS_KEY=your_key_here

# CARTO basemap key for the US map mode (optional override — the app ships
# with a built-in public raster key; this one is public by design):
# VITE_CARTO_KEY=your_key_here
