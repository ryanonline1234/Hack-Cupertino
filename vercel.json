{
  "rewrites": [
    {
      "source": "/api/census-geocoder/geocoder/:path(geographies/coordinates|locations/onelineaddress)",
      "destination": "https://geocoding.geo.census.gov/geocoder/:path"
    },
    {
      "source": "/api/nominatim/:path(search|reverse)",
      "destination": "https://nominatim.openstreetmap.org/:path"
    },
    {
      "source": "/api/cdc/resource/:path(cwsq-ngmh\\.json)",
      "destination": "https://data.cdc.gov/resource/:path"
    }
  ]
}
